# Copy this file to .env.local and fill in real values. Never commit .env.local.
#
# These must ALSO be set in your Vercel project (Settings > Environment
# Variables), ticked for every environment you deploy — Production, Preview
# and Development.
#
# Two gotchas that have bitten this project before:
#   1. NEXT_PUBLIC_* values are compiled into the build. Editing them in
#      Vercel does nothing until you REDEPLOY (with the build cache off).
#   2. Check the variable NAME as carefully as the value. A misnamed variable
#      is indistinguishable from a missing one at runtime — see
#      src/lib/supabase/env.ts, which names the offender for you.

# ---------------------------------------------------------------------------
# Supabase — one project hosts every league on this instance.
# Values come from Project Settings > Data API and > API Keys.
# ---------------------------------------------------------------------------

# Project URL. Safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# anon / publishable key. Safe to expose — Row Level Security is what protects
# the data, not secrecy of this key. Either the legacy `anon` JWT (eyJhbGci...)
# or a modern publishable key (sb_publishable_...) works.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Service-role key (Project Settings > API Keys > secret keys). Modern projects
# issue these as `sb_secret_...`; older ones have a legacy service_role JWT.
# Paste it as ONE UNBROKEN LINE — a wrapped paste produces whitespace that
# makes an invalid HTTP header.
#
# SERVER-ONLY. Bypasses Row Level Security entirely, across EVERY league on the
# instance. Never prefix with NEXT_PUBLIC_, never import into a client
# component, never log it. Used by the sync jobs (src/app/api/cron/*) and the
# push sender.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ---------------------------------------------------------------------------
# Tank01 (RapidAPI) — the NFL stat source. ONE key serves the whole instance:
# player/schedule/score data is fetched per NFL WEEK, not per league, so
# adding leagues costs no extra API calls.
#
# Subscribe at rapidapi.com to "Tank01 NFL Live In-Game Real Time Statistics".
# The cron cadences in vercel.json are sized against the Pro plan's
# 1,000 calls/day.
# ---------------------------------------------------------------------------
RAPIDAPI_KEY=your-rapidapi-key

# Optional: pin the NFL season the sync jobs fetch, for backfilling a past
# season. Leave unset in normal operation — the jobs derive it from the date.
# TANK01_SEASON=2026

# ---------------------------------------------------------------------------
# Cron authentication
# ---------------------------------------------------------------------------

# Shared secret guarding /api/cron/*. Vercel Cron sends it automatically as
# `Authorization: Bearer $CRON_SECRET`. Generate one with:
#   openssl rand -hex 32
# Without this set, the cron routes refuse to run at all rather than running
# unauthenticated.
CRON_SECRET=generate-a-long-random-string

# ---------------------------------------------------------------------------
# Web Push (optional — draft-turn and week-final notifications)
# Generate a VAPID keypair once with:  npx web-push generate-vapid-keys
# Omit all three and the app simply doesn't offer notifications.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key
# Contact address required by the Web Push spec; mailto: or https:.
VAPID_SUBJECT=mailto:you@example.com
